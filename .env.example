APP_NAME=Chartiko
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=
# Production: PostgreSQL behind PgBouncer (deploy/README.md). DB_PORT is the
# PgBouncer transaction pool; DB_DIRECT_PORT is PostgreSQL itself, used by
# migrations and admin commands. Without DB_DIRECT_PORT the connection is direct.
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=6432
# DB_DIRECT_PORT=5432
# DB_DATABASE=chartiko
# DB_USERNAME=chartiko
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
# Days of sign-in activity (email, IP, user agent) kept for the Admin view.
ADMIN_ACTIVITY_RETENTION_DAYS=90
# Alerts (alerts-engine): max rules per user; in-app notification retention
# (keep the privacy policy in sync).
ALERTS_MAX_PER_USER=10
ALERTS_NOTIFICATION_RETENTION_DAYS=90

# Owner identity for the privacy policy and legal notice (supplied by the
# owner, never invented). The privacy policy is published once name and a
# valid email are set; the legal notice also needs tax ID and address;
# registry is optional. Production name/email (and LOG_STACK=daily,
# LOG_DAILY_DAYS=14) are written by deploy/configure-legal-env.py. See
# docs/specs/legal-privacy-publication.md.
LEGAL_OWNER_NAME=
LEGAL_OWNER_TAX_ID=
LEGAL_OWNER_ADDRESS=
LEGAL_CONTACT_EMAIL=
LEGAL_OWNER_REGISTRY=
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# First-party SPA auth: dev SPA origins (Vite) + APP_URL host.
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1,localhost:5173,127.0.0.1:5173

# Internal Python engine (scraping/indicators). Laravel persists what it returns.
ENGINE_URL=http://127.0.0.1:8090

# Experimental Jev forecasts. Keep disabled until market-data transfer rights
# are confirmed; provide a concrete version (not jev-latest) when enabling.
JEV_ENABLED=false
JEV_MARKET_DATA_RIGHTS_VERIFIED=false
JEV_MODEL=
TYPESAFE_API_KEY=

# AI Company Card (OpenAI-compatible Chat Completions). Disabled until a
# provider is chosen; see docs/ai-company-card-operations.md. Never commit a key.
AI_CARD_ENABLED=false
AI_CARD_MARKET_DATA_RIGHTS_VERIFIED=false
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=40
AI_MAX_TOKENS=8000
AI_MAX_TOKENS_PARAM=max_tokens
AI_TEMPERATURE=0.2
AI_RESPONSE_FORMAT=json_schema
AI_RESPONSE_FORMAT_FALLBACK=true
AI_CARD_FRESHNESS_DAYS=7
AI_CARD_REQUESTS_PER_MINUTE=5
AI_CARD_USER_DAILY_LIMIT=10
AI_CARD_DAILY_LIMIT=200
AI_CARD_LOG_RETENTION_DAYS=90

# Natural-language Screener (ai-screener-natural-language): reuses the AI_*
# provider settings above with its own flag and limits (config/ai_screener.php).
# The query text is never stored or logged.
AI_SCREENER_ENABLED=false
AI_SCREENER_TIMEOUT_SECONDS=20
AI_SCREENER_MAX_TOKENS=800
AI_SCREENER_REQUESTS_PER_MINUTE=6
AI_SCREENER_USER_DAILY_LIMIT=30
AI_SCREENER_DAILY_LIMIT=600
AI_SCREENER_LOG_RETENTION_DAYS=90

# Company Fundamentals from SEC EDGAR (fundamentals:refresh, weekdays 07:00
# New York). Disabled until the operator sets a descriptive SEC_USER_AGENT:
# a name and a contact email, e.g. "Chartiko ops@example.com" (the SEC answers
# 403 without one). See docs/ai-company-card-operations.md.
SEC_FUNDAMENTALS_ENABLED=false
SEC_USER_AGENT=
SEC_REQUESTS_PER_SECOND=5
SEC_TIMEOUT_SECONDS=30
# Local QA fakes only (https:// or http://127.0.0.1); leave unset in production.
# SEC_DATA_BASE_URL=https://data.sec.gov
# SEC_TICKERS_URL=https://www.sec.gov/files/company_tickers.json

# Macro Series from FRED (macro:refresh, daily 10:00 New York and an isolated
# stage of ingestion:pipeline). Off until the operator sets MACRO_ENABLED=true
# and a free FRED API key (32 lower-case letters and digits) in the server
# .env only; never commit a key. NFCI (Chicago Fed, non-commercial terms) and
# VIXCLS (Cboe) stay off until their terms are cleared.
# See docs/specs/macro-series-fred.md.
MACRO_ENABLED=false
FRED_API_KEY=
MACRO_NFCI_ENABLED=false
MACRO_VIXCLS_ENABLED=false

# Daily EOD ingestion schedule (artisan schedule). The wall-clock time is
# interpreted in the market timezone, so it stays correct across DST.
# The pipeline fires at market_close + schedule_buffer_minutes on weekdays,
# skipping the committed NYSE holidays in config/ingestion.php.
INGESTION_TIMEZONE=America/New_York
INGESTION_MARKET_CLOSE=16:00
INGESTION_SCHEDULE_BUFFER_MINUTES=30
INGESTION_UNIVERSE=sp500
# Overlap lock TTL (seconds) for the ingestion:pipeline command lock.
INGESTION_LOCK_TTL_SECONDS=7200

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Admin EOD queries dispatch RunIngestionJob through the database queue. Keep a
# worker running with `php artisan queue:work` so the panel can observe queued
# -> running -> completed by polling without holding the browser request open.
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Daily alert email digest (docs/specs/alerts-email-digest.md). Off by default.
# Available only when ENABLED is true AND provider + location are set: the
# privacy policy names them. Configure MAIL_* (SMTP) and SPF/DKIM/DMARC first;
# see deploy/README.md "Email del resumen diario de alertas".
ALERT_EMAIL_DIGEST_ENABLED=false
ALERT_EMAIL_PROVIDER=
ALERT_EMAIL_PROVIDER_LOCATION=
ALERT_EMAIL_LEDGER_RETENTION_DAYS=90

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
